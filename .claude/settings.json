{
  "permissions": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "behavior": "allow"
      }
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "npm test",
            "onFailure": {
              "behavior": "report",
              "exitCode": 2
            }
          }
        ]
      }
    ]
  }
}
